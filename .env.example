# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Indian Market Data Feed (MOCK | LIVE)
MARKET_DATA_PROVIDER=MOCK
MOCK_UPDATE_INTERVAL_SEC=1.0

# -------------------------------------------------------------
# AI Intelligence Layer (Pydantic AI)
# Options: "ollama" | "gemini" | "groq" | "openai" | "fallback"
# -------------------------------------------------------------

# OPTION 1: Local Ollama (100% Offline, ₹0 cost, zero API keys)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# OPTION 2: Cloud Google Gemini (Free tier cloud API)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# OPTION 3: Cloud Groq (Ultra fast cloud inference)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here

# OPTION 4: Cloud OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Note: If no provider/keys are set, Dhanguru automatically uses its
# built-in deterministic rule engine with 100% uptime and zero crashes.
